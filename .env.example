# ============================================================
# SimpleBoard — 环境变量配置
# ============================================================
# 复制本文件为 .env.local 并填入实际值。
# cp .env.example .env.local
# ============================================================

# MongoDB Atlas 连接字符串（可选）
# 不设置则仅使用 localStorage，无云端同步功能。
# 格式: mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/<db>?retryWrites=true&w=majority
# 示例:
# MONGODB_URI=mongodb+srv://user:pass@cluster0.xxxxx.mongodb.net/myapp?retryWrites=true&w=majority
# 数据库集合前缀固定为 sb_（sb_boards, sb_preferences）。
MONGODB_URI=

# 访问密码（必填，用于页面认证）
# 支持多密码，用逗号分隔。不同密码登录后数据完全隔离。
# 示例: ACCESS_PASSWORD=pass1,pass2,pass3
# 密码通过 SHA-256 派生 deviceId，用作 localStorage 和 MongoDB 的数据命名空间。
# 不设置则无法通过登录页面。
ACCESS_PASSWORD=
